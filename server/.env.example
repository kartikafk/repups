# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Easiest option: free MongoDB Atlas cluster -> https://www.mongodb.com/cloud/atlas/register
# Example Atlas URI: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/formcoach
# Or local Mongo:    mongodb://127.0.0.1:27017/formcoach
MONGODB_URI=mongodb://127.0.0.1:27017/formcoach

# Port the API server runs on
PORT=5000

# Allowed origin for CORS (your client dev URL). Update after deploying.
CLIENT_ORIGIN=http://localhost:5173
